<style>
:root{
  --navy:#0F1923;
  --navy-2:#16232F;
  --teal:#4EA8A0;
  --gold:#C9A84C;
  --cream:#F7F6F2;
  --ink:#1a242e;
  --muted:#5c6b75;
  --line:#e3e0d8;
  --riw:#2E6FA8;
  --riw-soft:#EAF1F8;
  --serif:'Spectral',Georgia,serif;
  --sans:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --wrap:1140px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--sans);font-size:1rem;line-height:1.65;color:var(--ink);background:var(--cream);-webkit-font-smoothing:antialiased}
img,svg{max-width:100%}
a{color:inherit}
.wrap{width:100%;max-width:var(--wrap);margin:0 auto;padding:0 24px}
h1,h2,h3,h4{font-family:var(--serif);font-weight:600;line-height:1.18;letter-spacing:-.01em}
.eyebrow{font-family:var(--sans);font-size:.72rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--riw)}
.eyebrow-light{color:#9FC2E0}

/* HEADER */
.site-header{position:sticky;top:0;z-index:60;background:rgba(15,25,35,.96);backdrop-filter:blur(8px);border-bottom:1px solid rgba(255,255,255,.08)}
.hdr{display:flex;align-items:center;justify-content:space-between;gap:20px;height:64px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:#fff}
.brand-name{font-family:var(--serif);font-size:1.02rem;font-weight:600;letter-spacing:.01em;white-space:nowrap}
.brand-sub{display:block;font-family:var(--sans);font-size:.58rem;letter-spacing:.18em;text-transform:uppercase;color:#8FA3B3;margin-top:2px}
.nav{display:flex;align-items:center;gap:24px}
.nav a{font-size:.85rem;color:#C7D2DB;text-decoration:none}
.nav a:hover{color:#fff}
.btn-hdr{display:inline-flex;align-items:center;gap:7px;background:var(--teal);color:#08131b;font-size:.82rem;font-weight:600;padding:9px 16px;border-radius:3px;text-decoration:none}
.btn-hdr:hover{filter:brightness(1.07)}

/* HERO */
.hero{position:relative;background:linear-gradient(160deg,var(--navy) 0%,#0D2436 62%,#123449 100%);background-color:var(--navy);color:#fff;padding:72px 0 64px;overflow:hidden}
.hero::after{content:"";position:absolute;right:-140px;top:-120px;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(46,111,168,.42) 0%,rgba(46,111,168,0) 68%)}
.hero .wrap{position:relative;z-index:2}
.badge{display:inline-flex;align-items:center;gap:10px;border:1px solid rgba(46,111,168,.55);background:rgba(46,111,168,.16);color:#CFE2F3;font-size:.74rem;font-weight:600;letter-spacing:.09em;text-transform:uppercase;padding:8px 15px;border-radius:2px}
.badge .dot{width:7px;height:7px;border-radius:50%;background:var(--riw);flex:none}
h1{font-size:clamp(2.05rem,5vw,3.35rem);margin:26px 0 0;max-width:19ch}
h1 em{font-style:normal;color:#8CC0EC}
.lead{font-size:1.07rem;color:#C3D0DA;max-width:60ch;margin-top:20px}
.pills{display:flex;flex-wrap:wrap;gap:9px;margin-top:26px}
.pill{font-size:.78rem;color:#BBD4E8;border:1px solid rgba(255,255,255,.16);border-radius:2px;padding:6px 12px}
.cta-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
.btn{display:inline-flex;align-items:center;gap:9px;font-size:.9rem;font-weight:600;padding:14px 24px;border-radius:3px;text-decoration:none;border:1px solid transparent;min-height:48px}
.btn-gold{background:var(--gold);color:#241d05}
.btn-teal{background:var(--teal);color:#08131b}
.btn-ghost{border-color:rgba(255,255,255,.28);color:#fff}
.btn:hover{filter:brightness(1.07)}

/* STATS */
.stats{background:var(--navy-2);color:#fff;border-top:1px solid rgba(255,255,255,.07)}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(255,255,255,.08)}
.stat{background:var(--navy-2);padding:26px 22px}
.stat-n{font-family:var(--serif);font-size:1.45rem;font-weight:600;color:#8CC0EC}
.stat-l{font-size:.78rem;color:#93A6B4;margin-top:5px;line-height:1.45}

/* SECTIONS */
section{padding:76px 0}
.sec-head{max-width:64ch;margin-bottom:44px}
.sec-head h2{font-size:clamp(1.6rem,3.2vw,2.3rem);margin-top:12px}
.sec-head p{color:var(--muted);margin-top:14px}

/* MANIFESTO */
.manifesto{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.manifesto-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start}
.manifesto blockquote{font-family:var(--serif);font-size:clamp(1.35rem,2.6vw,1.85rem);line-height:1.35;border-left:3px solid var(--riw);padding-left:24px}
.manifesto p{color:var(--muted);margin-bottom:16px}

/* PERFIS */
.perfis{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.perfil{background:#fff;border:1px solid var(--line);border-top:3px solid var(--riw);border-radius:3px;padding:26px 22px}
.perfil .ico{color:var(--riw);margin-bottom:14px;display:block}
.perfil h3{font-size:1.08rem;margin-bottom:9px}
.perfil p{font-size:.9rem;color:var(--muted)}

/* SERVICOS */
.servicos{background:#fff;border-top:1px solid var(--line)}
.serv-list{display:grid;grid-template-columns:1fr 1fr;gap:0 44px}
.serv{display:flex;gap:18px;padding:24px 0;border-bottom:1px solid var(--line)}
.serv-n{font-family:var(--serif);font-size:1.05rem;font-weight:600;color:var(--riw);flex:none;width:34px;padding-top:2px}
.serv h3{font-size:1.03rem;margin-bottom:7px}
.serv p{font-size:.9rem;color:var(--muted)}
.serv-link{display:inline-flex;align-items:center;gap:6px;font-size:.82rem;font-weight:600;color:var(--riw);text-decoration:none;margin-top:10px}
.serv-link:hover{text-decoration:underline}
.serv-soon{display:inline-block;font-size:.74rem;color:var(--muted);border:1px dashed var(--line);border-radius:2px;padding:4px 9px;margin-top:10px}

/* CONTATO + LOCALIZACAO */
.contato{background:var(--cream);border-top:1px solid var(--line)}
.canais{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
.canal{display:flex;flex-direction:column;align-items:center;text-align:center;gap:10px;background:#fff;border:1px solid var(--line);border-radius:3px;padding:26px 16px;text-decoration:none;transition:border-color .15s ease,transform .15s ease}
.canal:hover{transform:translateY(-2px)}
.canal .bolha{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center}
.canal .rot{font-size:.68rem;font-weight:700;letter-spacing:.13em;text-transform:uppercase}
.canal .val{font-family:var(--serif);font-size:1rem;color:var(--ink)}
.c-wa{color:#1EA855} .c-ig{color:#C1275F} .c-li{color:#0A66C2} .c-yt{color:#C8102E} .c-gm{color:#2F8A82}
.c-wa .bolha{background:rgba(30,168,85,.1)} .c-ig .bolha{background:rgba(193,39,95,.1)}
.c-li .bolha{background:rgba(10,102,194,.1)} .c-yt .bolha{background:rgba(200,16,46,.1)}
.c-gm .bolha{background:rgba(47,138,130,.12)}
.c-wa:hover{border-color:#1EA855} .c-ig:hover{border-color:#C1275F} .c-li:hover{border-color:#0A66C2}
.c-yt:hover{border-color:#C8102E} .c-gm:hover{border-color:#2F8A82}
.email-pill{display:inline-flex;align-items:center;gap:9px;margin-top:22px;background:rgba(201,168,76,.14);border:1px solid var(--gold);color:#6b5716;font-size:.9rem;font-weight:600;padding:11px 20px;border-radius:999px;text-decoration:none}
.email-pill:hover{background:rgba(201,168,76,.24)}
.local{display:grid;grid-template-columns:1fr 1.15fr;gap:32px;align-items:stretch;margin-top:52px}
.local-info{background:#fff;border:1px solid var(--line);border-left:3px solid var(--riw);border-radius:3px;padding:30px}
.local-info h3{font-size:1.25rem;margin:10px 0 14px}
.local-info p{color:var(--muted);font-size:.93rem;margin-bottom:14px}
.local-info .btn{margin-top:6px}
.mapa{min-height:320px;border:1px solid var(--line);border-radius:3px;overflow:hidden;background:#e9e6df}
.mapa iframe{display:block;width:100%;height:100%;min-height:320px;border:0}

/* RADAR */
.radar{background:var(--navy);color:#fff}
.radar .sec-head h2{color:#fff}
.radar .sec-head p{color:#9FB0BD}
.radar-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.tese{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-left:3px solid var(--riw);border-radius:3px;padding:22px}
.tese-tag{font-size:.7rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#8CC0EC}
.tese h3{font-size:1rem;margin:10px 0 8px;color:#fff}
.tese p{font-size:.87rem;color:#A9BAC6}
.tese a{display:inline-block;font-size:.8rem;font-weight:600;color:#8CC0EC;text-decoration:none;margin-top:11px}
.tese a:hover{text-decoration:underline}

/* GRADE */
.grade-group{margin-bottom:40px}
.grade-group h3{font-size:1.12rem;padding-bottom:10px;border-bottom:1px solid var(--line);margin-bottom:20px}
.grade{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.card{display:block;background:#fff;border:1px solid var(--line);border-radius:3px;padding:22px;text-decoration:none;transition:border-color .15s ease,transform .15s ease}
.card:hover{border-color:var(--riw);transform:translateY(-2px)}
.card .kicker{font-size:.7rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--riw)}
.card h4{font-size:1rem;margin:9px 0 8px}
.card p{font-size:.87rem;color:var(--muted)}

/* CASO */
.caso{background:var(--riw-soft);border-top:1px solid #D5E3F0;border-bottom:1px solid #D5E3F0}
.caso-box{background:#fff;border:1px solid #D5E3F0;border-radius:3px;padding:36px}
.caso-box h2{font-size:1.5rem;margin:12px 0 18px}
.caso-box p{color:var(--muted);margin-bottom:14px}
.caso-nota{font-size:.8rem;color:var(--muted);border-top:1px solid var(--line);padding-top:14px;margin-top:8px}

/* FAQ */
.faq details{background:#fff;border:1px solid var(--line);border-radius:3px;margin-bottom:12px}
.faq summary{cursor:pointer;list-style:none;padding:18px 22px;font-family:var(--serif);font-size:1.04rem;font-weight:600;display:flex;justify-content:space-between;gap:16px;align-items:center}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";color:var(--riw);font-family:var(--sans);font-size:1.3rem;font-weight:400;flex:none}
.faq details[open] summary::after{content:"–"}
.faq .ans{padding:0 22px 20px;color:var(--muted);font-size:.93rem}

/* CTA FINAL */
.cta-final{background:var(--navy);color:#fff;text-align:center}
.cta-final h2{font-size:clamp(1.7rem,3.4vw,2.4rem);max-width:22ch;margin:14px auto 0}
.cta-final p{color:#A9BAC6;max-width:56ch;margin:18px auto 0}
.cta-final .cta-row{justify-content:center}

/* FOOTER */
.site-footer{background:#0A1219;color:#8FA3B3;padding:56px 0 92px;font-size:.86rem}
.foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:36px}
.site-footer h4{color:#fff;font-size:.95rem;margin-bottom:14px}
.site-footer a{color:#8FA3B3;text-decoration:none}
.site-footer a:hover{color:#fff}
.site-footer ul{list-style:none}
.site-footer li{margin-bottom:8px}
.disclaimer{border-top:1px solid rgba(255,255,255,.1);margin-top:36px;padding-top:20px;font-size:.79rem;color:#6C808F}

/* BARRA MOBILE */
.mobile-bar{display:none}

@media(max-width:980px){
  .nav{display:none}
  .stats-grid{grid-template-columns:1fr 1fr}
  .perfis{grid-template-columns:1fr 1fr}
  .serv-list{grid-template-columns:1fr;gap:0}
  .radar-grid{grid-template-columns:1fr 1fr}
  .grade{grid-template-columns:1fr 1fr}
  .canais{grid-template-columns:repeat(3,1fr)}
  .local{grid-template-columns:1fr;gap:20px}
  .manifesto-grid{grid-template-columns:1fr;gap:32px}
  .foot-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:640px){
  section{padding:56px 0}
  .hero{padding:52px 0 48px}
  .stats-grid{grid-template-columns:1fr 1fr}
  .perfis,.radar-grid,.grade{grid-template-columns:1fr}
  .canais{grid-template-columns:1fr 1fr}
  .canal{padding:20px 12px}
  .canal .val{font-size:.92rem}
  .email-pill{width:100%;justify-content:center;font-size:.82rem}
  .foot-grid{grid-template-columns:1fr}
  .caso-box{padding:24px}
  .btn{width:100%;justify-content:center}
  .btn-hdr{display:none}
  .mobile-bar{display:grid;grid-template-columns:1fr 1fr;position:fixed;left:0;right:0;bottom:0;z-index:80;background:var(--gold);border-top:1px solid #a98c33}
  .mobile-bar a{display:flex;align-items:center;justify-content:center;gap:8px;min-height:56px;font-size:.88rem;font-weight:700;color:#241d05;text-decoration:none}
  .mobile-bar a+a{border-left:1px solid rgba(0,0,0,.18)}
}
@media(prefers-reduced-motion:reduce){
  *{transition:none!important;animation:none!important}
  html{scroll-behavior:auto}
}
a:focus-visible,summary:focus-visible,details:focus-visible{outline:2px solid var(--riw);outline-offset:3px}
</style>
</head>
